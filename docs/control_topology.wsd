@startuml control_topology
title Nautilus Control Stack — ROS 2 Node & Topic Topology\nTopic / MsgType / QoS sourced from src/py_pkg/py_pkg/uuv_ros_core/

' ----------------------------------------------------------------------------
' Layout & style
' ----------------------------------------------------------------------------
top to bottom direction
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 110
skinparam padding 6
skinparam roundCorner 6
skinparam wrapWidth 220
skinparam defaultFontSize 12
skinparam ArrowFontSize 11

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor<<impl>>  #BDE0FE
  BorderColor<<impl>>      #1864AB
  BackgroundColor<<stub>>  #F1F3F5
  BorderColor<<stub>>      #868E96
  FontStyle<<stub>>        italic
}
skinparam actor {
  BackgroundColor #FFC9C9
  BorderColor     #C92A2A
}

legend bottom right
  | Style       | Meaning |
  | solid blue  | implemented in py_pkg |
  | dashed grey | stub subpackage (intentional scaffolding) |
  | edge label  | topic : MsgType (QoS) |
  | orange edge | non-ROS hardware link |
  Only topics defined in uuv_ros_core/topics.py are shown.
  Message types from message_types.py; QoS from qos_profiles.py.
endlegend

' ============================================================================
' NODES — declared in rank order (top → bottom).
' Two lanes: depth/buoyancy on the LEFT, attitude/pose on the RIGHT.
' Sensors enter at the top via the HAL/STM ingress; telemetry collects
' on the bottom-right.
' ============================================================================

' Rank -1 — sensor ingress (HAL bridge in sim, STM driver on hardware)
actor "sensors / HAL ingress\n(STM ↔ Pi or gz bridge)" as SENSORS

' Rank 0 — ingress / estimation source
component "ekf_prefilter"   as EKF_PRE <<stub>>
component "mqtt (talker)"   as MQTT     <<stub>>

' Rank 1 — estimation + mission planning
component "ekf"             as EKF      <<stub>>
component "pathfinding"     as PATH     <<impl>>

' Rank 2 — outer-loop PID
component "pid/depth_node\n<size:10>cascaded depth → BCU RPM, 10 Hz</size>" as PID_DEPTH <<impl>>
component "pid/acu_node\n<size:10>per-axis ACU PID, 10 Hz</size>"           as PID_ACU   <<impl>>

' Rank 3 — hardware drivers
component "bcu/bcu_node\n<size:10>BCU motor driver</size>" as BCU <<impl>>
component "acu/acu_node\n<size:10>ACU motor driver</size>" as ACU <<impl>>

' Rank 4 — actuators (external)
actor "BCU motor"  as BCU_HW
actor "ACU motors" as ACU_HW

' Side cluster — telemetry / CAN egress (right side, low rank)
component "telemetry\n(bundler + publisher)" as TELEM   <<stub>>
component "canopen_node"                     as CANNODE <<stub>>

' ============================================================================
' EDGES — every arrow has an explicit direction hint
' ============================================================================

' --- Sensor ingress (HAL/STM → control stack) ---
SENSORS -down-> EKF_PRE         : "/imu/left\nImu (SensorStream)"
SENSORS -down-> PID_DEPTH       : "/external/pressure\nInt32 (SafetyCritical)"

' --- Estimation chain (left column, top) ---
' EKF currently consumes only the LEFT filtered IMU; IMU_FILTERED_RIGHT is
' defined in the registry but not yet wired.
EKF_PRE -down-> EKF             : "/imu/filtered/left\nImu (Control)"

' --- Mission ingress (right column, top → down) ---
' pathfinding subscribes to both /command (one-shot) and /path (waypoint list).
MQTT -down-> PATH               : "/command\nString (Command)"
MQTT -down-> PATH               : "/path\nFloat32MultiArray (Command)"

' --- Estimation → planning / control ---
EKF -down-> PATH                : "/position/estimation\nPose (Control)"
EKF -down-> PID_ACU             : "/position/estimation\nPose (Control)"

' --- Planning → depth + attitude control ---
' Single Pose target fans out: depth_node consumes position.z, acu_node
' consumes orientation. Pathfinding is the sole producer of POSITION_TARGET.
PATH -down-> PID_DEPTH          : "/position/target\nPose (Control)"
PATH -down-> PID_ACU            : "/position/target\nPose (Control)"

' --- PID → hardware drivers (parallel verticals) ---
' BCU_RPM is Int16 on the wire (matches STM firmware contract).
PID_DEPTH -down-> BCU           : "/bcu/rpm\nInt16 (Control)"
' depth_node also drives the bladder valves (bit 0 = valve 1, bit 1 = valve 2).
PID_DEPTH -down-> BCU           : "/bcu/valves\nUInt8 (Control)"
' ACU pitch (Int16 mm of mass-shifter stroke) and roll (Int16 centidegrees,
' scale = ACU_ROLL_CDEG_PER_DEG) on a single arrow; both are Int16 on the wire.
PID_ACU   -down-> ACU           : "/acu/{pitch,roll}\nInt16 (Control)"

' --- Drivers → actuators (orange, hardware) ---
BCU -[#orange]down-> BCU_HW     : "EPOS set_velocity()"
ACU -[#orange]down-> ACU_HW     : "EPOS set_position()"

' --- Telemetry egress ---
TELEM -down-> CANNODE           : "/can/out\ncan_msgs/Frame (Control)"
TELEM -up-> MQTT                : "(internal, not a ROS topic)"

' ============================================================================
' Layout hints — invisible edges to keep ranks aligned across the two lanes
' ============================================================================
EKF_PRE -[hidden]right- MQTT
EKF     -[hidden]right- PATH
PID_DEPTH -[hidden]right- PID_ACU
BCU       -[hidden]right- ACU
BCU_HW    -[hidden]right- ACU_HW
TELEM     -[hidden]right- CANNODE

@enduml
